# Copy to .env and fill in per environment.

# Base URL of the backend API. Used by all server-side data fetching
# (actions/server-fetch.js) and the enquiry form submissions.
NEXT_PUBLIC_API_URL=https://electrosteel.onrender.com

# Base URL that relative CMS image/video paths are resolved against
# (createImageSourceURL / createVideoSourceURL in src/utils).
NEXT_PUBLIC_IMAGE_URL=https://electrosteel.onrender.com

# Public origin of THIS site. Drives canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. Must be the real production domain in prod —
# if unset it falls back to a Vercel preview URL and every canonical is wrong.
NEXT_PUBLIC_SITE_URL=https://www.example.com
